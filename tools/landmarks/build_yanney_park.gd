# BuildYanneyPark — landmark builder for Yanney Heritage Park (D-047; run this scene directly, no internet needed).
# Reads data/landmarks/yanney_park.json and writes one landmark scene per piece to world/landmarks/
# (yanney_tower, yanney_gardens, yanney_amphitheater, yanney_erc, yanney_splashground .scn), each placed by
# data/map/landmarks.json at the piece's map_xz, plus data/landmarks/yanney_plants.json (trees/shrubs/grass in
# map coords) that build_cells plants with the instanced vegetation. Re-run after editing the layout data, then
# re-run build_cells. Log also goes to tests/_look/yanney_build.txt.
# Depends on: DataLoader, LandmarkKit, yanney_tower.gd, yanney_gardens.gd, yanney_amphitheater.gd, yanney_erc.gd,
# yanney_splashground.gd.
extends Node

const DATA_PATH := "res://data/landmarks/yanney_park.json"
const Tower := preload("res://tools/landmarks/yanney_tower.gd")
const Gardens := preload("res://tools/landmarks/yanney_gardens.gd")
const Amphitheater := preload("res://tools/landmarks/yanney_amphitheater.gd")
const Erc := preload("res://tools/landmarks/yanney_erc.gd")
const Splashground := preload("res://tools/landmarks/yanney_splashground.gd")

var _log := PackedStringArray()


func _ready() -> void:
	var d := DataLoader.load_json(DATA_PATH)
	var mats: Dictionary = d.materials
	var pal: Dictionary = {}
	for id: String in d.palettes:
		var cols: Array = []
		for c: Array in d.palettes[id]:
			cols.append(Color(c[0], c[1], c[2]))
		pal[id] = cols
	var out := str(d.out_dir)
	var rng := RandomNumberGenerator.new()
	rng.seed = int(d.seed)

	var k := LandmarkKit.new("YanneyTower", mats)
	Tower.build(k, d.tower, pal, rng)
	_say(k.save(out + "/yanney_tower.scn"))

	var g: Dictionary = d.gardens
	k = LandmarkKit.new("YanneyGardens", mats)
	var local_plants: Array = Gardens.build(k, g, pal, rng)
	_say(k.save(out + "/yanney_gardens.scn"))

	var am: Dictionary = d.amphitheater
	var face := (_xz(am.faces_map_xz) - _xz(am.map_xz)).normalized()
	k = LandmarkKit.new("YanneyAmphitheater", mats)
	Amphitheater.build(k, am, atan2(-face.x, -face.y), pal, rng)
	_say(k.save(out + "/yanney_amphitheater.scn"))

	var erc: Dictionary = d.erc
	var axis := _xz(erc.long_axis_map).normalized()
	var origin := _xz(erc.map_xz)
	k = LandmarkKit.new("YanneyErc", mats)
	Erc.build(k, erc, atan2(-axis.y, axis.x), _xz(erc.dock_from_map) - origin, _xz(erc.dock_to_map) - origin, rng)
	_say(k.save(out + "/yanney_erc.scn"))

	k = LandmarkKit.new("YanneySplashground", mats)
	Splashground.build(k, d.splashground, pal, rng)
	_say(k.save(out + "/yanney_splashground.scn"))

	# Plants in map coordinates.
	var plants: Array = []
	var go := _xz(g.map_xz)
	for p: Array in local_plants:
		plants.append([p[0], snappedf(go.x + float(p[1]), 0.01), snappedf(go.y + float(p[2]), 0.01)])
	for zone: Dictionary in d.park_trees:
		var r: Array = zone.rect
		for i in int(zone.count):
			var kind := "tree_bare" if rng.randf() < 0.3 else "tree_leafy"
			plants.append([kind, snappedf(rng.randf_range(r[0], r[2]), 0.01), snappedf(rng.randf_range(r[1], r[3]), 0.01)])
	var f := FileAccess.open(str(d.plants_path), FileAccess.WRITE)
	f.store_string(JSON.stringify({"note": "Generated by tools/landmarks/build_yanney_park.tscn - do not edit.", "plants": plants}, "\t"))
	f.close()
	_say("%d plants -> %s" % [plants.size(), d.plants_path])
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path("res://tests/_look"))
	var lf := FileAccess.open("res://tests/_look/yanney_build.txt", FileAccess.WRITE)
	lf.store_string("\n".join(_log))
	lf.close()
	get_tree().quit()


func _xz(a: Array) -> Vector2:
	return Vector2(float(a[0]), float(a[1]))


func _say(s: String) -> void:
	print("YANNEY: " + s)
	_log.append(s)
