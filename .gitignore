# Godot 4+ specific ignores
.godot/
/android/

# Release builds (tools/release) and old local exports
/build/
/*.exe
/*.pck
/*.dll
*.TMP
/copy_result.txt

# Generated world cells: rebuild with tools/map_import/build_cells.tscn (sources are in data/map/source)
/world/generated/cells/

# Test screenshots and logs
/tests/_look/

# Mixamo characters and animations (D-112): their licence allows shipping them inside the built game
# but NOT distributing the raw files, and this repo is public. Keep a local backup of this folder.
/assets/characters/mixamo/
